    <string name="create_image_block_size">底層儲存塊大小 (Block Size)</string>
    <string name="create_image_bs_4096">4096 (4KB 推薦)</string>
    <string name="create_image_block_size_desc">檔案系統分配的最小數據塊單位。4096 位元組與 Android CPU 頁快取和閃存擦寫塊對齊，讀寫吞吐最佳。</string>
    <string name="create_image_inode_density">Inode 索引節點密度 (Bytes-per-Inode)</string>
    <string name="create_image_inode_4096">4096 (密集)</string>
    <string name="create_image_inode_8192">8192 (標準推薦)</string>
    <string name="create_image_inode_16384">16384 (大檔案)</string>
    <string name="create_image_inode_density_desc">每多少位元組預留一個 Inode 索引節點。若需注入大量小檔案或補丁，建議調小數值以防止 Inode 提前耗盡。</string>
    <string name="create_image_res_ratio">特權保留空間 (Reserved Ratio)</string>
    <string name="create_image_res_0">0% (全開)</string>
    <string name="create_image_res_1">1% (推薦)</string>
    <string name="create_image_res_5">5% (傳統)</string>
    <string name="create_image_res_ratio_desc" formatted="false">傳統 Linux 為 root 特權預留的保留空間。OverlayFS 映像中設為 1% 或 0% 可釋放更多可用容量。</string>
    <string name="create_image_features">EXT4 現代特性擴展 (-O features)</string>
    <string name="create_image_feat_dir_index">dir_index (目錄雜湊索引)</string>
