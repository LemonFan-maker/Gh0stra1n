<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2B2B36" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#3F3F4E" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#141418" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#22222A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A22" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#2E2E3C" />
        </shape>
    </item>
</selector>
