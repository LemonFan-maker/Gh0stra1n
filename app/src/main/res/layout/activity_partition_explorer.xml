<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_partition_explorer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 顶部导航与操作栏 -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_explorer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/maple_mono_regular"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Explorer"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_explorer_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/maple_mono_regular"
                android:maxLines="1"
                android:singleLine="true"
                android:text="EXT4"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 搜索 -->
        <ImageView
            android:id="@+id/btn_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_search"
            android:padding="7dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurface" />

        <!-- 显示/隐藏隐藏文件切换 -->
        <ImageView
            android:id="@+id/btn_toggle_hidden"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_toggle_hidden"
            android:padding="7dp"
            android:src="@drawable/ic_visibility"
            app:tint="?attr/colorPrimary" />

        <!-- 排序选项 -->
        <ImageView
            android:id="@+id/btn_sort"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_sort"
            android:padding="7dp"
            android:src="@drawable/ic_sort"
            app:tint="?attr/colorOnSurface" />

        <!-- 刷新 -->
        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_refresh"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 可展开的实时搜索栏 -->
    <LinearLayout
        android:id="@+id/layout_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/maple_mono_regular"
            android:hint="@string/explorer_search_hint"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btn_clear_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <!-- OverlayFS 架构层级快捷入口胶囊条 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_layer_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_gray"
                android:fontFamily="@font/maple_mono_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/explorer_root_tab"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_layer_upper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_gray"
                android:fontFamily="@font/maple_mono_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/explorer_upper_tab"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chip_layer_work"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_gray"
                android:fontFamily="@font/maple_mono_regular"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/explorer_work_tab"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <!-- 主浏览容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 正常文件列表视图 -->
        <LinearLayout
            android:id="@+id/layout_explorer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp">

            <!-- 面包屑路径导航条 -->
            <HorizontalScrollView
                android:id="@+id/scroll_breadcrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_breadcrumb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 当前目录状态统计栏 (项数 / 隐藏项数 / 大小) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_folder_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="@font/maple_mono_regular"
                    android:singleLine="true"
                    android:text="-"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txt_folder_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/maple_mono_regular"
                    android:text="-"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 文件列表 RecyclerView (撑满全屏) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_files"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- 空目录提示 -->
        <LinearLayout
            android:id="@+id/layout_empty_folder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/maple_mono_regular"
                android:text="@string/explorer_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 加载动画 -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorOutline"
                app:trackThickness="4dp" />

            <TextView
                android:id="@+id/txt_loading_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/maple_mono_regular"
                android:gravity="center"
                android:text="@string/explorer_loading"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
