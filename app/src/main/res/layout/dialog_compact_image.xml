<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="20dp">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_compress"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/dialog_compact_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compact_part_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_purple"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="system"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/maple_mono" />
    </LinearLayout>

    <!-- 镜像当前概况卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_compact_cap_status"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txt_compact_sizes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1024 MiB · 32 MiB"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/maple_mono" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_compact_image_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="system-34b7f67a.img"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/maple_mono" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 方案 1: tune2fs 保留块优化 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_compact_tune_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_compact_tune_desc"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tune_0"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/dialog_compact_tune_0"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tune_1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/dialog_compact_tune_1"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tune_5"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="@string/dialog_compact_tune_5"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginBottom="14dp" />

    <!-- 方案 2: 文件系统逻辑体积收缩 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_compact_shrink_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/txt_compact_min_limit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_compact_shrink_limit_calc"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <EditText
            android:id="@+id/edit_shrink_target_mib"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:inputType="number"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:fontFamily="@font/maple_mono"
            android:hint="@string/dialog_compact_shrink_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shrink_confirm"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="@string/dialog_compact_btn_shrink"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 底部关闭按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_compact_close"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/btn_done"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        app:strokeColor="?attr/colorOutline"
        app:cornerRadius="22dp" />

</LinearLayout>
