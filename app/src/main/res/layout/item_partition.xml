<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/part_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp">

        <!-- 顶栏: 状态指示点 + 分区标识 + 挂载路径 + 状态药丸 + 更多菜单按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/part_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_status_dot"
                android:visibility="gone"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/part_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="system"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/part_mount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="/system"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:fontFamily="@font/maple_mono"
                android:maxLines="1" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/part_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="LIVE"
                android:textColor="@color/status_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/maple_mono" />

            <ImageView
                android:id="@+id/btn_part_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="More" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- 详细信息: 配额/层级 + 镜像统计 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/part_layer_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1024 MiB"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/part_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 GiB"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/maple_mono" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
