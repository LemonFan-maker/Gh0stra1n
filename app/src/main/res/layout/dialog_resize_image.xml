<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="20dp">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_expand"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/dialog_resize_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resize_part_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_purple"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="system"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/maple_mono" />
    </LinearLayout>

    <!-- 当前镜像状态卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dialog_resize_cur_cap"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_resize_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="512 MiB"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/maple_mono" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_resize_image_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="system-34b7f67a.img"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/maple_mono" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 目标容量输入区 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_resize_target"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/edit_resize_target_mib"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:inputType="number"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/maple_mono"
            android:hint="768" />

        <TextView
            android:id="@+id/txt_target_gib_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="≈ 0.75 GiB"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:fontFamily="@font/maple_mono"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 快捷增量按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_256"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+256M"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_512"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+512M"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_1024"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+1GB"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_2048"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="+2GB"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- 在线模式状态提示 -->
    <TextView
        android:id="@+id/txt_resize_mode_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_resize_hint_mounted"
        android:textColor="@color/status_green"
        android:textSize="11sp"
        android:layout_marginBottom="16dp" />

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resize_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_cancel"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:strokeColor="?attr/colorOutline"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resize_confirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:text="@string/btn_resize_confirm"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="22dp" />
    </LinearLayout>

</LinearLayout>
